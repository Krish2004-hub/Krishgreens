//	}
    @Autowired
    private UserRepository userRepository;
    @Autowired
    private PasswordEncoder passwordEncoder;

    @GetMapping
    public List<UserEntity> getUsers() {
        // return Arrays.asList(new User(1L,"Krish","kish004@gmail.com"),new User(2L,"Tony","h004@gmail.com"),new User(3L,"","kish004@gmail.com"));
        return userRepository.findAll();
    }
    @PostMapping
    public UserEntity createUser(@RequestBody UserEntity user) {
    	 return userRepository.save(user); 
    }
    @GetMapping("/{id}")
    public UserEntity getUserById(@PathVariable Long id) {
        return userRepository.findById(id)
            .orElseThrow(()-> new ResourceNotFoundException("user not find in this id"));
    }	
    
    
    
    @PutMapping("/{id}")
    public UserEntity updateuser(@PathVariable Long id,@RequestBody UserEntity user) {
    	UserEntity userData= userRepository.findById(id)
         .orElseThrow(()-> new ResourceNotFoundException("user not find in this id"));
    	userData.setEmail(user.getEmail());
    	userData.setName(user.getName());
    	return userRepository.save(userData);
    }
    
    @DeleteMapping("/{id}")
    public ResponseEntity<Object> deleteUser(@PathVariable Long id) {
    	UserEntity userData= userRepository.findById(id)
    	         .orElseThrow(()-> new ResourceNotFoundException("user not find in this id"));
    	    	userRepository.delete(userData);
    	    	return ResponseEntity.ok().build();
    } }


